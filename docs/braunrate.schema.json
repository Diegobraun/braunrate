{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Diegobraun/braunrate/main/docs/braunrate.schema.json",
  "title": "braunrate scenario",
  "description": "The scenario file format. The editor uses this file to complete keys and point at errors before you run.",
  "type": "object",
  "required": [
    "name",
    "target",
    "load",
    "scenario"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "The scenario name. It appears at the top of the report."
    },
    "target": {
      "type": "string",
      "description": "Base address of the service under test. Example: http://127.0.0.1:8080. Use ${VARIABLE} so a real host does not get versioned.",
      "examples": [
        "http://127.0.0.1:8080",
        "${TARGET}"
      ]
    },
    "requires": {
      "type": "array",
      "description": "External infrastructure without which this scenario does not run. The CI example loop skips it with a warning instead of breaking.",
      "items": {
        "type": "string",
        "enum": [
          "kafka",
          "amqp",
          "credential"
        ]
      },
      "examples": [
        [
          "kafka"
        ]
      ]
    },
    "variables": {
      "type": "object",
      "description": "Values reused across the scenario. ${NAME:-default} reads from an environment variable with a fallback.",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "auth": {
      "$ref": "#/$defs/auth"
    },
    "tls": {
      "$ref": "#/$defs/tls",
      "description": "TLS to reach an HTTPS target: a private CA when the certificate is not signed by one the machine already trusts, and a client certificate when the target asks for mTLS."
    },
    "messaging": {
      "type": "object",
      "description": "How to reach Kafka and RabbitMQ when the broker asks for a credential. The default is still a local broker with no authentication.",
      "additionalProperties": false,
      "properties": {
        "kafka": {
          "$ref": "#/$defs/broker"
        },
        "amqp": {
          "$ref": "#/$defs/broker"
        }
      }
    },
    "data": {
      "type": "object",
      "description": "Data sources. Each key becomes a prefix usable as ${name.column}.",
      "additionalProperties": {
        "$ref": "#/$defs/dataSource"
      }
    },
    "load": {
      "$ref": "#/$defs/load"
    },
    "scenario": {
      "type": "array",
      "description": "Steps run in order, from the first to the last, once per scheduled arrival.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "slo": {
      "type": "array",
      "description": "The rules that decide whether the run passed. A failing rule makes the command exit with code 1.",
      "items": {
        "$ref": "#/$defs/sloRule"
      }
    }
  },
  "$defs": {
    "rate": {
      "type": "string",
      "description": "Arrivals per unit of time.",
      "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*(:-[^}]*)?\\}|([0-9]+(\\.[0-9]+)?|\\$\\{[A-Z][A-Z0-9_]*(:-[^}]*)?\\})/(s|m|h))$",
      "examples": [
        "300/s",
        "1200/m"
      ]
    },
    "duration": {
      "type": "string",
      "description": "A duration in Go format.",
      "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*(:-[^}]*)?\\}|[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))$",
      "examples": [
        "30s",
        "5m"
      ]
    },
    "load": {
      "type": "object",
      "description": "How the load is applied. The default is the open model: the rate does not depend on the target answering.",
      "additionalProperties": false,
      "properties": {
        "model": {
          "enum": [
            "open",
            "closed"
          ],
          "description": "'open' (the default) declares an arrival rate. 'closed' declares users in a loop: the rate becomes a consequence of the response time, and the report says a freeze in the target does not show up in the numbers."
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "description": "Stretches run in sequence. Open model only.",
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "users": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of simultaneous loops. Closed model only.",
          "examples": [
            200
          ]
        },
        "duration": {
          "type": "string",
          "description": "How long the users stay in the loop. Closed model only.",
          "examples": [
            "5m"
          ]
        },
        "thinkTime": {
          "type": "string",
          "description": "How long each user waits between one iteration and the next. Closed model only.",
          "examples": [
            "1s"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "profiles"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "users"
                ]
              },
              {
                "required": [
                  "duration"
                ]
              },
              {
                "required": [
                  "thinkTime"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "model",
            "users",
            "duration"
          ],
          "properties": {
            "model": {
              "const": "closed"
            }
          },
          "not": {
            "required": [
              "profiles"
            ]
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "ramp": {
          "type": "object",
          "description": "The rate rises linearly from one value to another.",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "duration"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/rate"
            },
            "to": {
              "$ref": "#/$defs/rate"
            },
            "duration": {
              "$ref": "#/$defs/duration"
            }
          }
        },
        "steady": {
          "type": "object",
          "description": "A constant rate for the declared time.",
          "additionalProperties": false,
          "required": [
            "rate",
            "duration"
          ],
          "properties": {
            "rate": {
              "$ref": "#/$defs/rate"
            },
            "duration": {
              "$ref": "#/$defs/duration"
            }
          }
        },
        "spike": {
          "type": "object",
          "description": "An instant jump to the declared rate.",
          "additionalProperties": false,
          "required": [
            "rate",
            "duration"
          ],
          "properties": {
            "rate": {
              "$ref": "#/$defs/rate"
            },
            "duration": {
              "$ref": "#/$defs/duration"
            }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "description": "One step of the scenario. The short form fits on one line: 'http: GET /orders/1'.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "The step name in the report and in the SLO rules. With no name, the protocol aggregation key is used."
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "description": "The share of this alternative in the mix. Each iteration runs one alternative. Either every step declares a weight or none does, and a weight does not coexist with a chained capture.",
          "examples": [
            60
          ]
        },
        "http": {
          "description": "The short form ('GET /path') or an object with method, path, headers, body and timeout.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) .+",
              "examples": [
                "GET /orders/${subscribers.id}"
              ]
            },
            {
              "$ref": "#/$defs/http"
            }
          ]
        },
        "capture": {
          "type": "object",
          "description": "Keeps a value from the response for the steps that follow. One line per value: 'invoiceId: $.lastInvoice.id'.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "description": "A JSON path, a header, a cookie or a regular expression.",
                "examples": [
                  "$.ultimaFatura.id",
                  "header:Location",
                  "cookie:sessao"
                ]
              },
              {
                "$ref": "#/$defs/detailedCapture"
              }
            ]
          }
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "graphql": {
          "description": "A GraphQL operation. The query can come on its own (the operation name is read from it) or inside a map with variables.",
          "oneOf": [
            {
              "type": "string",
              "examples": [
                "query LookUpOrder($id: ID!) { order(id: $id) { status } }"
              ]
            },
            {
              "$ref": "#/$defs/graphql"
            }
          ]
        },
        "kafka": {
          "$ref": "#/$defs/kafka",
          "description": "Produces a message on the topic. The key decides the partition, so it has to vary per iteration."
        },
        "amqp": {
          "$ref": "#/$defs/amqp",
          "description": "Publishes a message to a queue or an exchange."
        },
        "await": {
          "$ref": "#/$defs/await",
          "description": "Waits for this iteration's message to show up at the destination, closing the measurement of the asynchronous chain."
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "path": {
          "type": "string",
          "examples": [
            "/invoices/${invoiceId}/pay"
          ]
        },
        "url": {
          "type": "string",
          "description": "Same as path."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "body": {
          "description": "An object becomes JSON. Text goes as it is.",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean"
          ]
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "followRedirects": {
          "type": "boolean"
        }
      }
    },
    "detailedCapture": {
      "type": "object",
      "description": "The long form of a capture, for when a default value is needed or the capture may fail on purpose.",
      "additionalProperties": false,
      "required": [
        "from"
      ],
      "properties": {
        "from": {
          "type": "string",
          "examples": [
            "$.access_token"
          ]
        },
        "default": {
          "type": "string",
          "description": "The value used when the capture finds nothing."
        },
        "required": {
          "type": "boolean",
          "description": "True by default. A required capture that fails ends the iteration with a correlation error."
        }
      }
    },
    "expect": {
      "type": "object",
      "description": "What has to be true about the response. A failure here counts as an error in the report.",
      "additionalProperties": false,
      "properties": {
        "status": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            {
              "type": "string",
              "examples": [
                "2xx",
                "< 400"
              ]
            }
          ]
        },
        "json": {
          "type": "object",
          "description": "The expected JSON path. Example: '$.status: PAID'. Use 'exists' to only check presence.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "header": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "bodyContains": {
          "type": "string"
        },
        "bodyMatches": {
          "type": "string",
          "description": "A regular expression."
        }
      }
    },
    "auth": {
      "type": "object",
      "description": "How the engine obtains a credential and injects it into every step. The step does not have to declare a header.",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "token",
            "basic",
            "header"
          ]
        },
        "obtain": {
          "type": "object",
          "description": "The login request, performed once for the whole run. See ADR 0005.",
          "additionalProperties": false,
          "properties": {
            "http": {
              "$ref": "#/$defs/http"
            },
            "capture": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "refreshAfter": {
          "$ref": "#/$defs/duration"
        },
        "header": {
          "type": "string",
          "description": "The whole header line, name and value.",
          "default": "Authorization: Bearer ${token}"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "dataSource": {
      "type": "object",
      "description": "A CSV file or synthetic generation. Without it every iteration uses the same value and the target answers from cache.",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "examples": [
            "data/subscribers.csv"
          ]
        },
        "consume": {
          "enum": [
            "sequential",
            "random",
            "circular",
            "uniquePerUser"
          ],
          "description": "circular loops from the start to the end of the file; uniquePerUser never repeats a value."
        },
        "seed": {
          "type": [
            "integer",
            "string"
          ],
          "description": "Same seed, same data. It takes ${SEED:-42} to come from the environment. The seed that ran and the variable it came from go into the report and into the JSON.",
          "examples": [
            42,
            "${SEED:-42}"
          ]
        },
        "generate": {
          "type": "object",
          "description": "Synthetic fields. One value per iteration, stable across the whole journey.",
          "additionalProperties": {
            "$ref": "#/$defs/generatedField"
          }
        }
      }
    },
    "sloRule": {
      "type": "object",
      "description": "One rule per step, or for 'global', 'journey' and 'regression'. Example: '- journey: { p95: < 2s }'.",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "p50": {
            "$ref": "#/$defs/limit"
          },
          "p75": {
            "$ref": "#/$defs/limit"
          },
          "p90": {
            "$ref": "#/$defs/limit"
          },
          "p95": {
            "$ref": "#/$defs/limit"
          },
          "p99": {
            "$ref": "#/$defs/limit"
          },
          "p99.9": {
            "$ref": "#/$defs/limit"
          },
          "max": {
            "$ref": "#/$defs/limit"
          },
          "errors": {
            "$ref": "#/$defs/limit",
            "description": "A percentage. '< 0.1' is one tenth of one percent."
          },
          "success": {
            "$ref": "#/$defs/limit",
            "description": "A percentage. '>= 99.9' is the mirror reading of 'errors: < 0.1'."
          },
          "throughput": {
            "$ref": "#/$defs/limit",
            "description": "'global' only. Completed requests per second. Example: '>= 200/s'."
          },
          "journeyP50": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "journeyP75": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "journeyP90": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "journeyP95": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "journeyP99": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "journeyP99.9": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "journeyMax": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "globalP50": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "globalP75": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "globalP90": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "globalP95": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "globalP99": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "globalP99.9": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          },
          "globalMax": {
            "$ref": "#/$defs/limit",
            "description": "'regression' only. How much worse it may get against the baseline. Example: '<= 10%% worse'."
          }
        }
      }
    },
    "limit": {
      "type": [
        "string",
        "number"
      ],
      "description": "A comparison with a unit. Examples: '< 150ms', '>= 250/s', '< 0.1'.",
      "examples": [
        "< 150ms",
        "<= 2s",
        "> 250/s",
        "< 0.1"
      ]
    },
    "graphql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "description": "Same as query."
        },
        "operation": {
          "type": "string",
          "description": "The operation name. Only needed when the query carries more than one.",
          "examples": [
            "LookUpOrder"
          ]
        },
        "variables": {
          "description": "The operation variables. It takes ${data.column} and captured values.",
          "type": [
            "object",
            "string"
          ],
          "examples": [
            {
              "id": "${subscribers.id}"
            }
          ]
        },
        "path": {
          "type": "string",
          "default": "/graphql",
          "description": "The GraphQL endpoint. The default fits almost every service."
        },
        "url": {
          "type": "string",
          "description": "Same as path."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "value"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "examples": [
            "orders"
          ]
        },
        "key": {
          "type": "string",
          "description": "The message key. An always-identical key sends everything to the same partition, and the number comes out optimistic.",
          "examples": [
            "${orders.id}"
          ]
        },
        "value": {
          "description": "An object becomes JSON; text goes as it is.",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean"
          ]
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "brokers": {
          "description": "Default: the scenario target.",
          "type": [
            "array",
            "string"
          ],
          "items": {
            "type": "string"
          }
        },
        "acks": {
          "enum": [
            "all",
            "leader",
            "none"
          ],
          "default": "all",
          "description": "How many replicas acknowledge before the message counts as delivered."
        },
        "partition": {
          "type": "integer",
          "minimum": 0,
          "description": "Sends every message of this step to a single partition, ignoring the key. It concentrates the load on purpose, and the report says the number belongs to one partition.",
          "examples": [
            0
          ]
        },
        "group": {
          "type": "string",
          "description": "The consumer group to watch during the run. The report shows how many messages it fell behind, read from the broker.",
          "examples": [
            "billing"
          ]
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "amqp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body"
      ],
      "properties": {
        "queue": {
          "type": "string",
          "description": "The common case: publishes straight to the queue, which is declared if it does not exist."
        },
        "exchange": {
          "type": "string"
        },
        "routingKey": {
          "type": "string"
        },
        "body": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean"
          ]
        },
        "messageId": {
          "type": "string",
          "description": "Goes out as message-id and works as the correlation for the await step.",
          "examples": [
            "${orders.id}"
          ]
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "url": {
          "type": "string",
          "examples": [
            "amqp://guest:guest@127.0.0.1:5672/"
          ]
        },
        "persistent": {
          "type": "boolean",
          "default": true
        },
        "confirm": {
          "type": "boolean",
          "default": true,
          "description": "Waits for the broker to confirm. Turning it off measures the write to the socket, not the delivery."
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "await": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kafka": {
          "type": [
            "object",
            "string"
          ],
          "additionalProperties": false,
          "properties": {
            "topic": {
              "type": "string"
            },
            "brokers": {
              "type": [
                "array",
                "string"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        "amqp": {
          "type": [
            "object",
            "string"
          ],
          "additionalProperties": false,
          "properties": {
            "queue": {
              "type": "string"
            },
            "topic": {
              "type": "string"
            },
            "url": {
              "type": [
                "array",
                "string"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        "http": {
          "type": [
            "object",
            "string"
          ],
          "additionalProperties": false,
          "description": "Polls a request until the 'until' condition holds. For a system that only shows the effect through an API.",
          "properties": {
            "path": {
              "type": "string",
              "examples": [
                "/orders/${orders.id}"
              ]
            },
            "url": {
              "type": "string",
              "description": "Same as path."
            }
          }
        },
        "key": {
          "type": "string",
          "description": "The value that identifies this iteration's message.",
          "examples": [
            "${orders.id}"
          ]
        },
        "equals": {
          "type": "string",
          "description": "Same as key."
        },
        "field": {
          "type": "string",
          "description": "A JSON path inside the message, when the correlation is not in the key.",
          "examples": [
            "$.order"
          ]
        },
        "timeout": {
          "$ref": "#/$defs/duration",
          "default": "30s"
        },
        "to": {
          "type": "object",
          "description": "The condition that ends the wait over http: status, bodyContains or a JSON path with the expected value.",
          "examples": [
            {
              "$.status": "PROCESSED"
            },
            {
              "status": 200
            }
          ],
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "interval": {
          "$ref": "#/$defs/duration",
          "default": "500ms",
          "description": "How often to poll. The measured latency has that granularity."
        }
      }
    },
    "generatedField": {
      "description": "A short recipe (\"uuid\", \"number(10,500)\") or the long form with type, format and newEvery.",
      "oneOf": [
        {
          "type": "string",
          "examples": [
            "uuid",
            "sequence",
            "number(10,500)",
            "integer(1,99)",
            "name",
            "email",
            "text(8)",
            "cpf",
            "cnpj"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "uuid",
                "sequence",
                "number",
                "integer",
                "name",
                "email",
                "text",
                "pattern",
                "cpf",
                "cnpj"
              ]
            },
            "format": {
              "type": "string",
              "description": "For type: pattern only. # becomes a digit, @ becomes a letter, everything else comes out literal.",
              "examples": [
                "ORD-######",
                "@@-####"
              ]
            },
            "newEvery": {
              "type": "string",
              "enum": [
                "iteration",
                "use"
              ],
              "default": "iteration",
              "description": "iteration keeps the same value across the whole journey, which is what an idempotency key needs."
            }
          }
        }
      ]
    },
    "broker": {
      "type": "object",
      "description": "How to reach the broker. A secret never stays in the file: 'password' only takes a reference to an environment variable, like ${KAFKA_PASSWORD}.",
      "additionalProperties": false,
      "properties": {
        "brokers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Broker addresses.",
          "examples": [
            [
              "kafka.staging:9093"
            ]
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "saslPlain",
                "scramSha256",
                "scramSha512",
                "mskIam",
                "certificate"
              ],
              "description": "saslPlain and scramSha* use a user and a password. mskIam signs with the standard AWS chain and never asks for a key. certificate is mTLS. OAUTHBEARER is not in v1."
            },
            "user": {
              "type": "string",
              "description": "The broker user. It can come from ${VARIABLE}."
            },
            "password": {
              "type": "string",
              "pattern": "^\\\\$\\\\{[A-Za-z_][A-Za-z0-9_]*\\\\}$",
              "description": "A reference to an environment variable only: ${KAFKA_PASSWORD}. A literal value is refused at validation, and so is a fallback value, because the fallback would be the secret written in the file.",
              "examples": [
                "${KAFKA_PASSWORD}"
              ]
            },
            "region": {
              "type": "string",
              "description": "The AWS region, required for mskIam.",
              "examples": [
                "us-east-1"
              ]
            }
          }
        },
        "tls": {
          "$ref": "#/$defs/tls"
        }
      }
    },
    "tls": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ca": {
              "type": "string",
              "description": "A private CA, in PEM."
            },
            "certificate": {
              "type": "string",
              "description": "A client certificate, for mTLS."
            },
            "key": {
              "type": "string",
              "description": "The key of the client certificate."
            }
          }
        }
      ],
      "description": "true for TLS with the system CAs, or a map with a private CA and a client certificate."
    }
  }
}
