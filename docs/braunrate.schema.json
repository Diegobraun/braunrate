{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Diegobraun/braunrate/main/docs/braunrate.schema.json",
  "title": "Cenario braunrate",
  "description": "Formato do arquivo de cenario. O editor usa este arquivo para completar chaves e apontar erro antes de rodar.",
  "type": "object",
  "required": [
    "nome",
    "alvo",
    "carga",
    "cenario"
  ],
  "additionalProperties": false,
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do cenario. Aparece no topo do relatorio."
    },
    "alvo": {
      "type": "string",
      "description": "Endereco base do servico sob teste. Ex.: http://127.0.0.1:8080. Use ${VARIAVEL} para nao versionar host real.",
      "examples": [
        "http://127.0.0.1:8080",
        "${ALVO}"
      ]
    },
    "requer": {
      "type": "array",
      "description": "Infraestrutura externa sem a qual este cenario nao roda. O laco de exemplos do CI pula com aviso em vez de quebrar.",
      "items": {
        "type": "string",
        "enum": [
          "kafka",
          "amqp",
          "credencial"
        ]
      },
      "examples": [
        [
          "kafka"
        ]
      ]
    },
    "variaveis": {
      "type": "object",
      "description": "Valores reaproveitados no cenario. ${NOME:-padrao} le da variavel de ambiente com valor de reserva.",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "autenticacao": {
      "$ref": "#/$defs/autenticacao"
    },
    "tls": {
      "$ref": "#/$defs/tls",
      "description": "TLS para alcancar o alvo HTTPS: CA propria quando o certificado nao e assinado por uma CA que a maquina ja confia, e certificado de cliente quando o alvo exige mTLS."
    },
    "mensageria": {
      "type": "object",
      "description": "Como alcancar Kafka e RabbitMQ quando o broker exige credencial. O padrao continua sendo broker local sem autenticacao.",
      "additionalProperties": false,
      "properties": {
        "kafka": {
          "$ref": "#/$defs/broker"
        },
        "amqp": {
          "$ref": "#/$defs/broker"
        }
      }
    },
    "dados": {
      "type": "object",
      "description": "Fontes de dados. Cada chave vira um prefixo usavel como ${nome.coluna}.",
      "additionalProperties": {
        "$ref": "#/$defs/fonteDeDados"
      }
    },
    "carga": {
      "$ref": "#/$defs/carga"
    },
    "cenario": {
      "type": "array",
      "description": "Passos executados em ordem, do primeiro ao ultimo, uma vez por chegada agendada.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/passo"
      }
    },
    "slo": {
      "type": "array",
      "description": "Regras que decidem se a execucao passou. Regra falha faz o comando sair com codigo 1.",
      "items": {
        "$ref": "#/$defs/regraDeSLO"
      }
    }
  },
  "$defs": {
    "taxa": {
      "type": "string",
      "description": "Chegadas por unidade de tempo.",
      "pattern": "^[0-9]+(\\.[0-9]+)?/(s|m|h)$",
      "examples": [
        "300/s",
        "1200/m"
      ]
    },
    "duracao": {
      "type": "string",
      "description": "Duracao no formato do Go.",
      "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h)$",
      "examples": [
        "30s",
        "5m"
      ]
    },
    "carga": {
      "type": "object",
      "description": "Como a carga e aplicada. O padrao e o modelo aberto: a taxa nao depende de o alvo responder.",
      "additionalProperties": false,
      "properties": {
        "modelo": {
          "enum": [
            "aberto",
            "fechado"
          ],
          "description": "'aberto' (padrao) declara taxa de chegada. 'fechado' declara usuarios em laco: a taxa vira consequencia do tempo de resposta e o relatorio avisa que travada do alvo nao aparece nos numeros."
        },
        "perfis": {
          "type": "array",
          "minItems": 1,
          "description": "Trechos executados em sequencia. So no modelo aberto.",
          "items": {
            "$ref": "#/$defs/perfil"
          }
        },
        "usuarios": {
          "type": "integer",
          "minimum": 1,
          "description": "Numero de lacos simultaneos. So no modelo fechado.",
          "examples": [
            200
          ]
        },
        "duracao": {
          "type": "string",
          "description": "Por quanto tempo os usuarios ficam em laco. So no modelo fechado.",
          "examples": [
            "5m"
          ]
        },
        "intervalo_entre_iteracoes": {
          "type": "string",
          "description": "Espera de cada usuario entre uma iteracao e a proxima. So no modelo fechado.",
          "examples": [
            "1s"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "perfis"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "usuarios"
                ]
              },
              {
                "required": [
                  "duracao"
                ]
              },
              {
                "required": [
                  "intervalo_entre_iteracoes"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "modelo",
            "usuarios",
            "duracao"
          ],
          "properties": {
            "modelo": {
              "const": "fechado"
            }
          },
          "not": {
            "required": [
              "perfis"
            ]
          }
        }
      ]
    },
    "perfil": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "rampa": {
          "type": "object",
          "description": "Taxa sobe linearmente de um valor a outro.",
          "additionalProperties": false,
          "required": [
            "de",
            "ate",
            "durante"
          ],
          "properties": {
            "de": {
              "$ref": "#/$defs/taxa"
            },
            "ate": {
              "$ref": "#/$defs/taxa"
            },
            "durante": {
              "$ref": "#/$defs/duracao"
            }
          }
        },
        "patamar": {
          "type": "object",
          "description": "Taxa constante pelo tempo declarado.",
          "additionalProperties": false,
          "required": [
            "taxa",
            "durante"
          ],
          "properties": {
            "taxa": {
              "$ref": "#/$defs/taxa"
            },
            "durante": {
              "$ref": "#/$defs/duracao"
            }
          }
        },
        "constante": {
          "type": "object",
          "description": "Mesmo que patamar.",
          "additionalProperties": false,
          "required": [
            "taxa",
            "durante"
          ],
          "properties": {
            "taxa": {
              "$ref": "#/$defs/taxa"
            },
            "durante": {
              "$ref": "#/$defs/duracao"
            }
          }
        },
        "pico": {
          "type": "object",
          "description": "Salto instantaneo para a taxa declarada.",
          "additionalProperties": false,
          "required": [
            "taxa",
            "durante"
          ],
          "properties": {
            "taxa": {
              "$ref": "#/$defs/taxa"
            },
            "durante": {
              "$ref": "#/$defs/duracao"
            }
          }
        }
      }
    },
    "passo": {
      "type": "object",
      "description": "Um passo do cenario. A forma curta cabe em uma linha: 'http: GET /pedidos/1'.",
      "additionalProperties": false,
      "properties": {
        "nome": {
          "type": "string",
          "description": "Nome do passo no relatorio e nas regras de SLO. Sem nome, vale a chave de agregacao do protocolo."
        },
        "peso": {
          "type": "integer",
          "minimum": 1,
          "description": "Proporcao desta alternativa no mix. Cada iteracao executa uma alternativa. Ou todo passo declara peso, ou nenhum declara, e peso nao convive com captura encadeada.",
          "examples": [
            60
          ]
        },
        "http": {
          "description": "Forma curta ('GET /caminho') ou objeto com metodo, caminho, cabecalhos, corpo e timeout.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) .+",
              "examples": [
                "GET /pedidos/${assinantes.id}"
              ]
            },
            {
              "$ref": "#/$defs/http"
            }
          ]
        },
        "captura": {
          "type": "object",
          "description": "Guarda valor da resposta para os passos seguintes. Uma linha por valor: 'faturaId: $.ultimaFatura.id'.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "description": "Caminho JSON, cabecalho, cookie ou expressao regular.",
                "examples": [
                  "$.ultimaFatura.id",
                  "cabecalho:Location",
                  "cookie:sessao"
                ]
              },
              {
                "$ref": "#/$defs/capturaDetalhada"
              }
            ]
          }
        },
        "verificar": {
          "$ref": "#/$defs/verificar"
        },
        "espera": {
          "$ref": "#/$defs/verificar"
        },
        "graphql": {
          "description": "Operacao GraphQL. A consulta pode vir sozinha (o nome da operacao sai dela) ou dentro de um mapa com variaveis.",
          "oneOf": [
            {
              "type": "string",
              "examples": [
                "query ConsultarPedido($id: ID!) { pedido(id: $id) { status } }"
              ]
            },
            {
              "$ref": "#/$defs/graphql"
            }
          ]
        },
        "kafka": {
          "$ref": "#/$defs/kafka",
          "description": "Produz uma mensagem no topico. A chave decide a particao, entao ela precisa variar por iteracao."
        },
        "amqp": {
          "$ref": "#/$defs/amqp",
          "description": "Publica uma mensagem numa fila ou troca."
        },
        "aguardar": {
          "$ref": "#/$defs/aguardar",
          "description": "Espera a mensagem desta iteracao aparecer no destino, fechando a medicao da cadeia assincrona."
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metodo": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "caminho": {
          "type": "string",
          "examples": [
            "/faturas/${faturaId}/pagar"
          ]
        },
        "url": {
          "type": "string",
          "description": "Mesmo que caminho."
        },
        "cabecalhos": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "corpo": {
          "description": "Objeto vira JSON. Texto vai como esta.",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean"
          ]
        },
        "timeout": {
          "$ref": "#/$defs/duracao"
        },
        "seguir_redirect": {
          "type": "boolean"
        }
      }
    },
    "capturaDetalhada": {
      "type": "object",
      "description": "Forma longa da captura, para quando falta valor padrao ou a captura pode falhar de proposito.",
      "additionalProperties": false,
      "required": [
        "de"
      ],
      "properties": {
        "de": {
          "type": "string",
          "examples": [
            "$.access_token"
          ]
        },
        "padrao": {
          "type": "string",
          "description": "Valor usado quando a captura nao encontra nada."
        },
        "obrigatoria": {
          "type": "boolean",
          "description": "Padrao true. Captura obrigatoria que falha encerra a iteracao com erro de correlacao."
        }
      }
    },
    "verificar": {
      "type": "object",
      "description": "O que precisa ser verdade na resposta. Falha aqui conta como erro no relatorio.",
      "additionalProperties": false,
      "properties": {
        "status": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            {
              "type": "string",
              "examples": [
                "2xx",
                "< 400"
              ]
            }
          ]
        },
        "json": {
          "type": "object",
          "description": "Caminho JSON esperado. Ex.: '$.status: PAGA'. Use 'existe' para so checar presenca.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "cabecalho": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "corpo_contem": {
          "type": "string"
        },
        "corpo_casa": {
          "type": "string",
          "description": "Expressao regular."
        }
      }
    },
    "autenticacao": {
      "type": "object",
      "description": "Como o motor obtem credencial e a injeta em todos os passos. O passo nao precisa declarar cabecalho.",
      "required": [
        "tipo"
      ],
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "enum": [
            "token",
            "basica",
            "cabecalho"
          ]
        },
        "obter": {
          "type": "object",
          "description": "Requisicao de login, executada uma vez para a execucao inteira. Ver ADR 0005.",
          "additionalProperties": false,
          "properties": {
            "http": {
              "$ref": "#/$defs/http"
            },
            "captura": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "renovar_apos": {
          "$ref": "#/$defs/duracao"
        },
        "cabecalho": {
          "type": "string",
          "description": "Nome do cabecalho. Padrao Authorization.",
          "default": "Authorization"
        },
        "usuario": {
          "type": "string"
        },
        "senha": {
          "type": "string"
        }
      }
    },
    "fonteDeDados": {
      "type": "object",
      "description": "Arquivo CSV ou geracao sintetica. Sem isto, toda iteracao usa o mesmo valor e o alvo responde de cache.",
      "additionalProperties": false,
      "properties": {
        "arquivo": {
          "type": "string",
          "examples": [
            "dados/assinantes.csv"
          ]
        },
        "consumo": {
          "enum": [
            "sequencial",
            "aleatorio",
            "circular",
            "unico_por_usuario"
          ],
          "description": "circular repete do inicio ao fim do arquivo; unico_por_usuario nao repete valor."
        },
        "semente": {
          "type": [
            "integer",
            "string"
          ],
          "description": "Mesma semente, mesmos dados. Aceita ${SEMENTE:-42} para vir do ambiente. A semente que rodou e a variavel de onde ela veio vao para o relatorio e para o JSON.",
          "examples": [
            42,
            "${SEMENTE:-42}"
          ]
        },
        "gerar": {
          "type": "object",
          "description": "Campos sinteticos. Um valor por iteracao, estavel na jornada inteira.",
          "additionalProperties": {
            "$ref": "#/$defs/campoGerado"
          }
        }
      }
    },
    "regraDeSLO": {
      "type": "object",
      "description": "Uma regra por passo, ou por 'global', 'jornada' e 'regressao'. Ex.: '- jornada: { p95: < 2s }'.",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "p50": {
            "$ref": "#/$defs/limite"
          },
          "p75": {
            "$ref": "#/$defs/limite"
          },
          "p90": {
            "$ref": "#/$defs/limite"
          },
          "p95": {
            "$ref": "#/$defs/limite"
          },
          "p99": {
            "$ref": "#/$defs/limite"
          },
          "p99.9": {
            "$ref": "#/$defs/limite"
          },
          "max": {
            "$ref": "#/$defs/limite"
          },
          "erros": {
            "$ref": "#/$defs/limite",
            "description": "Porcentagem. '< 0.1' e um decimo de um por cento."
          },
          "vazao": {
            "$ref": "#/$defs/limite",
            "description": "Nome antigo de taxa_efetiva, so em 'global'."
          },
          "sucesso": {
            "$ref": "#/$defs/limite",
            "description": "Porcentagem. '>= 99.9' e a leitura espelhada de 'erros: < 0.1'."
          },
          "taxa_efetiva": {
            "$ref": "#/$defs/limite",
            "description": "So em 'global'. Requisicoes concluidas por segundo. Ex.: '>= 200/s'."
          },
          "jornada_p50": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "jornada_p75": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "jornada_p90": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "jornada_p95": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "jornada_p99": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "jornada_p99.9": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "jornada_max": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "global_p50": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "global_p75": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "global_p90": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "global_p95": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "global_p99": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "global_p99.9": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          },
          "global_max": {
            "$ref": "#/$defs/limite",
            "description": "So em 'regressao'. Quanto pode piorar em relacao a base. Ex.: '<= 10%% pior'."
          }
        }
      }
    },
    "limite": {
      "type": [
        "string",
        "number"
      ],
      "description": "Comparacao com unidade. Ex.: '< 150ms', '>= 250/s', '< 0.1'.",
      "examples": [
        "< 150ms",
        "<= 2s",
        "> 250/s",
        "< 0.1"
      ]
    },
    "graphql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consulta": {
          "type": "string",
          "description": "Texto da operacao. O nome dela vira a linha do relatorio, entao nao use operacao anonima."
        },
        "query": {
          "type": "string",
          "description": "Mesmo que consulta."
        },
        "operacao": {
          "type": "string",
          "description": "Nome da operacao. So precisa quando a consulta traz mais de uma.",
          "examples": [
            "ConsultarPedido"
          ]
        },
        "variaveis": {
          "description": "Variaveis da operacao. Aceita ${dados.coluna} e valores capturados.",
          "type": [
            "object",
            "string"
          ],
          "examples": [
            {
              "id": "${assinantes.id}"
            }
          ]
        },
        "caminho": {
          "type": "string",
          "default": "/graphql",
          "description": "Endpoint GraphQL. O padrao serve para quase todo servico."
        },
        "url": {
          "type": "string",
          "description": "Mesmo que caminho."
        },
        "cabecalhos": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "timeout": {
          "$ref": "#/$defs/duracao"
        }
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topico",
        "valor"
      ],
      "properties": {
        "topico": {
          "type": "string",
          "examples": [
            "pedidos"
          ]
        },
        "chave": {
          "type": "string",
          "description": "Chave da mensagem. Chave sempre igual manda tudo para a mesma particao, e o numero fica otimista.",
          "examples": [
            "${pedidos.id}"
          ]
        },
        "valor": {
          "description": "Objeto vira JSON; texto vai como esta.",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean"
          ]
        },
        "cabecalhos": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "brokers": {
          "description": "Padrao: o alvo do cenario.",
          "type": [
            "array",
            "string"
          ],
          "items": {
            "type": "string"
          }
        },
        "acks": {
          "enum": [
            "todos",
            "lider",
            "nenhum"
          ],
          "default": "todos",
          "description": "Quantas replicas confirmam antes de a mensagem contar como entregue."
        },
        "particao": {
          "type": "integer",
          "minimum": 0,
          "description": "Manda toda a mensagem deste passo para uma particao so, ignorando a chave. Concentra a carga de proposito, e o relatorio avisa que o numero e o de uma particao.",
          "examples": [
            0
          ]
        },
        "grupo": {
          "type": "string",
          "description": "Grupo de consumidores a observar durante a execucao. O relatorio mostra quantas mensagens ele ficou para tras, lido do broker.",
          "examples": [
            "cobranca"
          ]
        },
        "timeout": {
          "$ref": "#/$defs/duracao"
        }
      }
    },
    "amqp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpo"
      ],
      "properties": {
        "fila": {
          "type": "string",
          "description": "Caso comum: publica direto na fila, que e declarada se nao existir."
        },
        "troca": {
          "type": "string"
        },
        "rota": {
          "type": "string"
        },
        "corpo": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean"
          ]
        },
        "identidade": {
          "type": "string",
          "description": "Vai como message-id e serve de correlacao para o passo aguardar.",
          "examples": [
            "${pedidos.id}"
          ]
        },
        "cabecalhos": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "url": {
          "type": "string",
          "examples": [
            "amqp://guest:guest@127.0.0.1:5672/"
          ]
        },
        "persistente": {
          "type": "boolean",
          "default": true
        },
        "confirmar": {
          "type": "boolean",
          "default": true,
          "description": "Espera o broker confirmar. Desligar mede a escrita no socket, nao a entrega."
        },
        "timeout": {
          "$ref": "#/$defs/duracao"
        }
      }
    },
    "aguardar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kafka": {
          "type": [
            "object",
            "string"
          ],
          "additionalProperties": false,
          "properties": {
            "topico": {
              "type": "string"
            },
            "brokers": {
              "type": [
                "array",
                "string"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        "amqp": {
          "type": [
            "object",
            "string"
          ],
          "additionalProperties": false,
          "properties": {
            "fila": {
              "type": "string"
            },
            "topico": {
              "type": "string"
            },
            "url": {
              "type": [
                "array",
                "string"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        "http": {
          "type": [
            "object",
            "string"
          ],
          "additionalProperties": false,
          "description": "Sonda uma requisicao ate a condicao 'ate' valer. Para sistema que so mostra o efeito por API.",
          "properties": {
            "caminho": {
              "type": "string",
              "examples": [
                "/pedidos/${pedidos.id}"
              ]
            },
            "url": {
              "type": "string",
              "description": "Mesmo que caminho."
            }
          }
        },
        "chave": {
          "type": "string",
          "description": "Valor que identifica a mensagem desta iteracao.",
          "examples": [
            "${pedidos.id}"
          ]
        },
        "igual_a": {
          "type": "string",
          "description": "Mesmo que chave."
        },
        "campo": {
          "type": "string",
          "description": "Caminho JSON dentro da mensagem, quando a correlacao nao esta na chave.",
          "examples": [
            "$.pedido"
          ]
        },
        "timeout": {
          "$ref": "#/$defs/duracao",
          "default": "30s"
        },
        "ate": {
          "type": "object",
          "description": "Condicao que encerra a espera por http: status, corpo_contem ou um caminho JSON com o valor esperado.",
          "examples": [
            {
              "$.status": "PROCESSADO"
            },
            {
              "status": 200
            }
          ],
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "intervalo": {
          "$ref": "#/$defs/duracao",
          "default": "500ms",
          "description": "De quanto em quanto tempo sondar. A latencia medida tem essa granularidade."
        }
      }
    },
    "campoGerado": {
      "description": "Receita curta (\"uuid\", \"numero(10,500)\") ou a forma longa com tipo, formato e novo_a_cada.",
      "oneOf": [
        {
          "type": "string",
          "examples": [
            "uuid",
            "sequencia",
            "numero(10,500)",
            "inteiro(1,99)",
            "nome",
            "email",
            "texto(8)",
            "cpf",
            "cnpj"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo"
          ],
          "properties": {
            "tipo": {
              "type": "string",
              "enum": [
                "uuid",
                "sequencia",
                "numero",
                "inteiro",
                "nome",
                "email",
                "texto",
                "padrao",
                "cpf",
                "cnpj"
              ]
            },
            "formato": {
              "type": "string",
              "description": "So para tipo: padrao. # vira digito, @ vira letra, o resto sai literal.",
              "examples": [
                "PED-######",
                "@@-####"
              ]
            },
            "novo_a_cada": {
              "type": "string",
              "enum": [
                "iteracao",
                "uso"
              ],
              "default": "iteracao",
              "description": "iteracao mantem o mesmo valor na jornada inteira, que e o caso da chave de idempotencia."
            }
          }
        }
      ]
    },
    "broker": {
      "type": "object",
      "description": "Como alcancar o broker. Segredo nunca fica no arquivo: 'senha' so aceita referencia a variavel de ambiente, como ${KAFKA_SENHA}.",
      "additionalProperties": false,
      "properties": {
        "brokers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Enderecos do broker.",
          "examples": [
            [
              "kafka.homolog:9093"
            ]
          ]
        },
        "autenticacao": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo"
          ],
          "properties": {
            "tipo": {
              "enum": [
                "sasl_plain",
                "scram_sha256",
                "scram_sha512",
                "msk_iam",
                "certificado"
              ],
              "description": "sasl_plain e scram_* usam usuario e senha. msk_iam assina com a cadeia padrao da AWS e nunca pede chave. certificado e mTLS. OAUTHBEARER nao entra na v1."
            },
            "usuario": {
              "type": "string",
              "description": "Usuario do broker. Pode vir de ${VARIAVEL}."
            },
            "senha": {
              "type": "string",
              "pattern": "^\\\\$\\\\{[A-Za-z_][A-Za-z0-9_]*\\\\}$",
              "description": "So referencia a variavel de ambiente: ${KAFKA_SENHA}. Valor literal e recusado na validacao, e valor de reserva tambem, porque a reserva seria o segredo escrito no arquivo.",
              "examples": [
                "${KAFKA_SENHA}"
              ]
            },
            "regiao": {
              "type": "string",
              "description": "Regiao da AWS, obrigatoria em msk_iam.",
              "examples": [
                "us-east-1"
              ]
            }
          }
        },
        "tls": {
          "$ref": "#/$defs/tls"
        }
      }
    },
    "tls": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ca": {
              "type": "string",
              "description": "CA propria, em PEM."
            },
            "certificado": {
              "type": "string",
              "description": "Certificado de cliente, para mTLS."
            },
            "chave": {
              "type": "string",
              "description": "Chave do certificado de cliente."
            }
          }
        }
      ],
      "description": "true para TLS com as CAs do sistema, ou um mapa com CA propria e certificado de cliente."
    }
  }
}
